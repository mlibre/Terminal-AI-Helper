#!/usr/bin/env bash
# npm's bin shim is a symlink into the package directory, and install.sh reads
# its own location to decide what to install from — so resolve the symlink
# chain to the real file first, then hand over to the installer at the
# package root, one level above bin/.
set -e
src="${BASH_SOURCE[0]:-$0}"
while [ -L "$src" ]; do
  dir="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [ "${src:0:1}" = "/" ] || src="$dir/$src"
done
exec bash "$(cd "$(dirname "$src")/.." && pwd)/install.sh" "$@"
