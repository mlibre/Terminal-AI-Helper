{
  "name": "terminal-ai-helper",
  "version": "3.2.5",
  "description": "The terminal that knows your next command Bash/Zsh suggestions that learn from your own history Offline and private with no account required",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlibre/Terminal-AI-Helper.git"
  },
  "keywords": [
    "cli",
    "terminal",
    "shell",
    "zsh",
    "bash",
    "autocomplete",
    "suggestions",
    "history"
  ],
  "files": [
    "bin",
    "plugins",
    "install.sh",
    "VERSION",
    "LICENSE",
    "readme.md"
  ],
  "bin": {
    "tai": "bin/tai.js"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "postinstall": "bash bin/npm-postinstall",
    "prepublishOnly": "find plugins -name '*.zwc' -delete && find . -name '*.zwc' -not -path './node_modules/*' -delete"
  },
  "devDependencies": {
    "vitepress": "^1.6.3"
  }
}
